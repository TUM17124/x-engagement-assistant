{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "X Engagement Assistant",
  "version": "0.2.0",
  "identifier": "org.xengagement.assistant",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'none'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/xea-backend"
    ],
    "category": "Productivity",
    "shortDescription": "AI drafts. You decide.",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ],
        "startMenuFolder": "X Engagement Assistant",
        "installerHooks": "installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "resources": {
      "../docs/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../LICENSE": "LICENSE"
    }
  }
}
