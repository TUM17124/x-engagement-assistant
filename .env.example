# Optional development import only. Desktop users configure credentials in Settings.
# X Developer App
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=

# Must exactly match the callback configured in the X Developer Console.
X_REDIRECT_URI=http://127.0.0.1:8787/auth/callback

# Random local secret for browser session signing.
SESSION_SECRET=replace-with-a-long-random-string

# X web search default
DEFAULT_QUERY=("pdf editor" OR ebooks OR "indie hacker" OR SaaS OR authors OR "reading app") lang:en -is:retweet

# OpenAI-compatible local/cloud text generation used by Generate Reply.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
